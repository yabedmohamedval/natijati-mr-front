{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "national-exams-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": { "style": "scss", "skipTests": true }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/national-exams-frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public", "ignore": ["images/logo.png"] },
              { "glob": "LICENSE", "input": "node_modules/@fontsource-variable/inter", "output": "licenses/inter" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource/tajawal", "output": "licenses/tajawal" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource/material-symbols-outlined", "output": "licenses/material-symbols-outlined" }
            ],
            "styles": ["src/tailwind.css", "src/fonts.css", "src/styles.scss"],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "1MB", "maximumError": "2MB" },
                { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "16kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false }
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "national-exams-frontend:build:production"
            },
            "development": {
              "buildTarget": "national-exams-frontend:build:development",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": { "builder": "@angular-devkit/build-angular:extract-i18n" },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "builderMode": "application",
            "karmaConfig": "karma.conf.cjs",
            "browsers": "ChromeHeadless",
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              { "glob": "**/*", "input": "public", "ignore": ["images/logo.png"] },
              { "glob": "LICENSE", "input": "node_modules/@fontsource-variable/inter", "output": "licenses/inter" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource/tajawal", "output": "licenses/tajawal" },
              { "glob": "LICENSE", "input": "node_modules/@fontsource/material-symbols-outlined", "output": "licenses/material-symbols-outlined" }
            ],
            "styles": ["src/tailwind.css", "src/fonts.css", "src/styles.scss"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
